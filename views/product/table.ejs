<%- include('../header') %>

    <div class="d-flex w-100" style="min-height: 100vh; background-color: #1e1e2f;">

        <%- include('../sidebar') %>

            <div class="main-content-wrapper flex-grow-1" id="mainContent">

                <%- include('../navbar') %>

                    <div class="container-fluid py-4">

                        <div class="d-flex align-items-center justify-content-between border-0 pt-4 px-4 mb-4">
                            <div>
                                <h4 class="font-weight-bold text-white mb-2">
                                    <span style="color: #6c5dd3; margin-right: 8px;">📦</span> Products
                                </h4>
                                <p class="text-white small mb-0">
                                    Manage, track, and update all product listings available in your system.
                                </p>
                            </div>
                            <a href="/product/add" class="btn text-white px-4 shadow-sm d-flex align-items-center"
                                style="background-color: #6c5dd3; border-radius: 10px; font-weight: 500; gap: 8px;">
                                <span>➕</span> Add Product
                            </a>
                        </div>

                        <div class="px-4">
                            <div class="table-responsive style-table-container">
                                <table class="table text-white mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">ID
                                            </th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                Image</th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                Product Name</th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                Category</th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                Sub Category</th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                Extra Category</th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                Brand</th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                Price</th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                Sale</th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                Qty</th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                Status</th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold text-right">
                                                Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (typeof products !=='undefined' && products.length> 0) { %>
                                            <% products.forEach((product, index)=> { %>
                                                <tr class="align-middle border-bottom-row">
                                                    <td>
                                                        <%= index + 1 %>
                                                    </td>

                                                    <td>
                                                        <% if (product.image) { %>
                                                            <img src="/uploads/<%= product.image %>"
                                                                alt="<%= product.name %>" class="category-thumbnail">
                                                            <% } else { %>
                                                                <div class="category-thumbnail-placeholder">
                                                                    <span>📦</span>
                                                                </div>
                                                                <% } %>
                                                    </td>

                                                    <td class="font-weight-bold text-dark">
                                                        <%= product.name %>
                                                    </td>

                                                    <td class="text-secondary small">
                                                        <%= product.category ? product.category.name : "-" %>
                                                    </td>
                                                    <td class="text-secondary small">
                                                        <%= product.subCategory ? product.subCategory.name : "-" %>
                                                    </td>
                                                    <td class="text-secondary small">
                                                        <%= product.extraSubCategory ? product.extraSubCategory.name
                                                            : "-" %>
                                                    </td>

                                                    <td class="text-secondary small">
                                                        <%= product.brand || "-" %>
                                                    </td>

                                                    <td class="font-weight-bold" style="color: #6c5dd3;">₹<%=
                                                            product.price %>
                                                    </td>

                                                    <td class="text-secondary small">₹<%= product.salePrice || "0" %>
                                                    </td>

                                                    <td>
                                                        <span
                                                            class="small font-weight-500 <%= product.quantity < 5 ? 'text-danger' : 'text-white' %>">
                                                            <%= product.quantity %>
                                                        </span>
                                                    </td>

                                                    <td>
                                                        <span
                                                            class="badge px-3 py-2 rounded-pill <%= product.status === 'Active' ? 'badge-active' : 'badge-inactive' %>">
                                                            <%= product.status || 'Active' %>
                                                        </span>
                                                    </td>

                                                    <td class="text-right">
                                                        <div class="d-flex justify-content-end gap-2" style="gap: 8px;">
                                                            <a href="/product/edit/<%= product._id %>"
                                                                class="btn btn-sm text-white border-0 action-btn-hover"
                                                                style="background-color: #2a2a40;">✏️</a>
                                                    <a href="/product/delete/<%= product._id %>" 
                                                        class="btn btn-sm text-white border-0 action-btn-hover"
                                                        style="background-color: #2a2a40;"
                                                        onclick="return confirm('Are you sure?')">
                                                        🗑️
                                                    </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="12"
                                                                class="text-center py-5 text-secondary small">
                                                                No Products Found. Click "+ Add Product" to insert your
                                                                first item.
                                                            </td>
                                                        </tr>
                                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
            </div>
    </div>

    <style>
        .main-content-wrapper {
            margin-left: 260px;
            min-height: 100vh;
            padding: 30px;
            transition: all 0.3s ease-in-out;
        }

        .style-table-container {
            background-color: #1a1a26;
            border: 1px solid #2d3238;
            border-radius: 12px;
            overflow: hidden;
        }

        .table thead {
            background-color: #222235;
        }

        .table th,
        .table td {
            padding: 16px 20px;
            vertical-align: middle;
        }

        .border-bottom-row {
            border-bottom: 1px solid #252538;
        }


        .category-thumbnail {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #5c5780;
        }

        .category-thumbnail-placeholder {
            width: 50px;
            height: 50px;
            background-color: #252538;
            border: 1px dashed #5c5780;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .badge-active {
            background-color: rgba(40, 167, 69, 0.15);
            color: #28a745;
        }

        .badge-inactive {
            background-color: rgba(220, 53, 69, 0.15);
            color: #dc3545;
        }

        .action-btn-hover:hover {
            background-color: #6c5dd3 !important;
            transition: background 0.2s ease;
        }

        .font-weight-500 {
            font-weight: 500;
        }

        ::placeholder {
            color: rgba(209, 209, 209, 0.15) !important;
        }
    </style>