<div class="sidebar bg-dark text-white vh-100 position-fixed"
    style="width: 260px; border-right: 1px solid #2d3238; z-index: 1000; background-color: #1e1e2f !important;">
    <div class="p-4">
        <h3 class="text-center mb-4 font-weight-bold" style="color: #6c5dd3; letter-spacing: 1px;">
            <i class="fa-solid fa-chart-pie mr-2"></i>UserHub
        </h3>

        <hr style="border-color: #2d3238;" class="mb-4">

        <ul class="nav flex-column gap-2">

            <!-- Dashboard -->

            <li class="nav-item mb-2">
                <a href="/dashboard" class="nav-link text-white active-link d-flex align-items-center">
                    📊 Dashboard
                </a>
            </li>


            <li class="nav-item mt-3 mb-1">
                <small class="text-uppercase text-secondary">
                    Logged In
                </small>
            </li>

            <div class="text-center text-white mb-4">

                <h6>
                    <%= currentUser.firstName %>
                        <%= currentUser.lastName %>
                </h6>

                <small class="text-warning">
                    <%= currentUser.role %>
                </small>

            </div>

            <!--  SUPER ADMIN  -->

            <% if(currentUser.role==="Super Admin" ){ %>

                <li class="nav-item">
                    <a href="/users/add" class="nav-link text-white">➕ Add User</a>
                </li>

                <li class="nav-item">
                    <a href="/users" class="nav-link text-white">👥 Users</a>
                </li>

                <li class="nav-item">
                    <a href="/category" class="nav-link text-white">
                        📂 Category
                    </a>
                </li>

                <li class="nav-item">
                    <a href="/subcategory" class="nav-link text-white">
                        📁 Sub Category
                    </a>
                </li>

                <li class="nav-item">
                    <a href="/extrasubcategory" class="nav-link text-white">
                        🗂 Extra Category
                    </a>
                </li>

                <li class="nav-item">
                    <a href="/product" class="nav-link text-white">
                        📦 Product
                    </a>
                </li>

                <li class="nav-item">
                    <a href="/order" class="nav-link text-white">
                        🛒 Orders
                    </a>
                </li>

                <% } %>

                    <!-- ADMIN  -->

                    <% if(currentUser.role==="Admin" ){ %>

                        <li class="nav-item">
                            <a href="/users" class="nav-link text-white">
                                👥 Users
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/category" class="nav-link text-white">
                                📂 Category
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/subcategory" class="nav-link text-white">
                                📁 Sub Category
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/extrasubcategory" class="nav-link text-white">
                                🗂 Extra Category
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/product" class="nav-link text-white">
                                📦 Product
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/order" class="nav-link text-white">
                                🛒 Orders
                            </a>
                        </li>

                        <% } %>

                            <!--  MANAGER  -->

                            <% if(currentUser.role==="Manager" ){ %>

                                <li class="nav-item">
                                    <a href="/category" class="nav-link text-white">
                                        📂 Category
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a href="/product" class="nav-link text-white">
                                        📦 Product
                                    </a>
                                </li>

                                <% } %>


                                    <!--  EMPLOYEE  -->

                                    <% if(currentUser.role==="Employee" ){ %>

                                        <li class="nav-item">
                                            <a href="/product" class="nav-link text-white">
                                                📦 Product
                                            </a>
                                        </li>

                                        <% } %>



                                            <li class="nav-item mt-4">
                                                <a href="/profile" class="nav-link text-white">
                                                    👤 My Profile
                                                </a>
                                            </li>

                                            <li class="nav-item">
                                                <a href="/profile/change-password" class="nav-link text-white">
                                                    🔒 Change Password
                                                </a>
                                            </li>

                                            <li class="nav-item">
                                                <a href="/logout" class="nav-link text-danger">
                                                    🚪 Logout
                                                </a>
                                            </li>

        </ul>
    </div>
</div>

<style>
    .hover-link:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
        opacity: 1 !important;
        color: #6c5dd3 !important;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .active-link {
        background-color: rgba(108, 93, 211, 0.15) !important;
        color: #6c5dd3 !important;
        font-weight: 600;
        border-radius: 8px;
    }

    .gap-3 {
        gap: 12px;
    }
</style>