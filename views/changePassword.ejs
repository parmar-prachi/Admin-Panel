<%- include('header') %>
    <div class="d-flex w-100" style="min-height: 100vh; background-color: #1e1e2f;">

        <div class="d-flex w-100" style="min-height: 100vh;">

            <%- include('sidebar') %>

                <div class="main-content-wrapper flex-grow-1" id="mainContent">

                    <%- include('navbar') %>

                        <div class="container-fluid py-4">

                            <div class="card-header border-0 pt-4 px-4">
                                <h4 class="font-weight-bold text-white mb-2">
                                    <span style="color: #6c5dd3; margin-right: 8px;">🔐</span> Change Password
                                </h4>
                                <p class="text-white small mb-0">Update your security credentials to keep your account
                                    safe.</p>
                            </div>

                            <div class="card-body p-4" style="max-width: 600px;">
                                <form action="/profile/change-password" method="POST">

                                    <div class="mb-3">
                                        <label class="font-weight-500 text-secondary small">Current Password</label>
                                        <input type="password" name="currentPassword" class="form-control custom-input"
                                            required>
                                    </div>

                                    <div class="mb-3">
                                        <label class="font-weight-500 text-secondary small">New Password</label>
                                        <input type="password" name="newPassword" class="form-control custom-input"
                                            required>
                                    </div>

                                    <div class="mb-4">
                                        <label class="font-weight-500 text-secondary small">Confirm New Password</label>
                                        <input type="password" name="confirmPassword" class="form-control custom-input"
                                            required>
                                    </div>

                                    <div class="d-flex align-items-center justify-content-start mt-4"
                                        style="gap: 12px;">
                                        <button type="submit" class="btn text-white px-5 shadow-sm"
                                            style="background-color: #6c5dd3; border-radius: 10px; font-weight: 500;">
                                            <i class="fa-solid fa-key mr-2"></i> Update Password
                                        </button>
                                        <a href="/profile" class="btn btn-light px-4"
                                            style="border-radius: 10px; font-weight: 500;">Cancel</a>
                                    </div>

                                </form>
                            </div>
                        </div>
                </div>
        </div>
    </div>

    <style>
        .main-content-wrapper {
            margin-left: 260px;
            min-height: 100vh;
            padding: 30px;
            transition: all 0.3s ease-in-out;
        }

        .custom-input {
            background-color: #1e1e2f !important;
            border: 1px solid #5c5780 !important;
            border-radius: 10px !important;
            padding: 10px 14px !important;
            height: auto !important;
            color: white !important;
            transition: all 0.2s ease-in-out !important;
        }

        .custom-input:focus {
            background-color: #1e1e2f !important;
            border-color: #6c5dd3 !important;
            box-shadow: 0 0 0 3px rgba(108, 93, 211, 0.15) !important;
        }

        .sidebar.collapsed {
            transform: translateX(-260px);
            margin-right: -260px;
        }

        .main-content-wrapper.expanded {
            margin-left: 0px;
        }

        .font-weight-500 {
            font-weight: 500;
        }
    </style>