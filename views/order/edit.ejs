<%- include('../header') %>

    <div class="d-flex w-100" style="min-height:100vh;background:#1e1e2f;">

        <%- include('../sidebar') %>

            <div class="main-content-wrapper flex-grow-1">

                <%- include('../navbar') %>

                    <div class="container-fluid py-4">

                        <div class="card shadow border-0" style="background:#222235;max-width:700px;">

                            <div class="card-header text-white">

                                ✏️ Update Order

                            </div>

                            <div class="card-body">

                                <form action="/order/update/<%= order._id %>" method="POST">

                                    <div class="mb-3">

                                        <label class="text-secondary">

                                            Order Number

                                        </label>

                                        <input type="text" class="form-control custom-input"
                                            value="<%= order.orderNumber %>" readonly>

                                    </div>

                                    <div class="mb-3">

                                        <label class="text-secondary">

                                            Customer

                                        </label>

                                        <input type="text" class="form-control custom-input"
                                            value="<%= order.customerName %>" readonly>

                                    </div>

                                    <div class="mb-3">

                                        <label class="text-secondary">

                                            Product

                                        </label>

                                        <input type="text" class="form-control custom-input"
                                            value="<%= order.product.name %>" readonly>

                                    </div>
                                    <!-- Order Status -->

                                    <div class="mb-3">

                                        <label class="text-secondary">

                                            Order Status

                                        </label>

                                        <select name="orderStatus" class="form-control custom-input">

                                            <option value="Pending" <%=order.orderStatus==="Pending" ? "selected" : ""
                                                %>>
                                                Pending
                                            </option>

                                            <option value="Processing" <%=order.orderStatus==="Processing" ? "selected"
                                                : "" %>>
                                                Processing
                                            </option>

                                            <option value="Packed" <%=order.orderStatus==="Packed" ? "selected" : "" %>>
                                                Packed
                                            </option>

                                            <option value="Shipped" <%=order.orderStatus==="Shipped" ? "selected" : ""
                                                %>>
                                                Shipped
                                            </option>

                                            <option value="Delivered" <%=order.orderStatus==="Delivered" ? "selected"
                                                : "" %>>
                                                Delivered
                                            </option>

                                            <option value="Cancelled" <%=order.orderStatus==="Cancelled" ? "selected"
                                                : "" %>>
                                                Cancelled
                                            </option>

                                        </select>

                                    </div>


                                    <!-- Payment Status -->

                                    <div class="mb-4">

                                        <label class="text-secondary">

                                            Payment Status

                                        </label>

                                        <select name="paymentStatus" class="form-control custom-input">

                                            <option value="Pending" <%=order.paymentStatus==="Pending" ? "selected" : ""
                                                %>>
                                                Pending
                                            </option>

                                            <option value="Paid" <%=order.paymentStatus==="Paid" ? "selected" : "" %>>
                                                Paid
                                            </option>

                                            <option value="Failed" <%=order.paymentStatus==="Failed" ? "selected" : ""
                                                %>>
                                                Failed
                                            </option>

                                            <option value="Refunded" <%=order.paymentStatus==="Refunded" ? "selected"
                                                : "" %>>
                                                Refunded
                                            </option>

                                        </select>

                                    </div>


                                    <button type="submit" class="btn text-white px-5" style="background:#6c5dd3;">

                                        💾 Update Order

                                    </button>

                                    <a href="/order" class="btn btn-light">

                                        Cancel

                                    </a>

                                </form>

                            </div>

                        </div>

                    </div>

            </div>

    </div>

    <style>
        .main-content-wrapper {

            margin-left: 260px;
            min-height: 100vh;
            padding: 30px;

        }

        .custom-input {

            background: #1e1e2f !important;

            border: 1px solid #5c5780 !important;

            color: white !important;

            border-radius: 10px;

        }

        .custom-input:focus {

            border-color: #6c5dd3 !important;

            box-shadow: 0 0 0 3px rgba(108, 93, 211, .15);

        }

        select.custom-input option {

            background: #1e1e2f;

            color: white;

        }
    </style>