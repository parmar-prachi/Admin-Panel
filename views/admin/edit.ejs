<%- include('../header') %>
    <div class="d-flex w-100" style="min-height: 100vh; background-color: #1e1e2f;">

        <div class="d-flex w-100" style="min-height: 100vh;">

            <%- include('../sidebar') %>

                <div class="main-content-wrapper flex-grow-1" id="mainContent">

                    <%- include('../navbar') %>

                        <div class="container-fluid py-4">

                            <div class="card-header border-0 pt-4 px-4">
                                <h4 class="font-weight-bold text-white mb-2">
                                    <span style="color: #6c5dd3; margin-right: 8px;">📝</span> Edit Admin Profile
                                </h4>
                                <p class="text-white small mb-0">Update account credentials, system privileges, and
                                    status settings for this administrator.</p>
                            </div>

                            <div class="card-body p-4" style="max-width: 750px;">
                                <form method="POST"
                                    action="/admin/update/<%= typeof admin !== 'undefined' ? admin._id : '' %>">

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="font-weight-500 text-secondary small">First Name</label>
                                            <input type="text" class="form-control custom-input" name="firstName"
                                                value="<%= typeof admin !== 'undefined' ? admin.firstName : '' %>"
                                                required>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label class="font-weight-500 text-secondary small">Last Name</label>
                                            <input type="text" class="form-control custom-input" name="lastName"
                                                value="<%= typeof admin !== 'undefined' ? admin.lastName : '' %>"
                                                required>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="font-weight-500 text-secondary small">Email Address</label>
                                            <input type="email" class="form-control custom-input" name="email"
                                                value="<%= typeof admin !== 'undefined' ? admin.email : '' %>" required>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label class="font-weight-500 text-secondary small">Mobile Number</label>
                                            <input type="text" class="form-control custom-input" name="mobile"
                                                value="<%= typeof admin !== 'undefined' ? admin.mobile : '' %>">
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="font-weight-500 text-secondary small">Access Role</label>
                                            <select name="role" class="form-control custom-input">
                                                <option value="Super Admin" <%=typeof admin !=='undefined' &&
                                                    admin.role=="Super Admin" ? "selected" : "" %>>Super Admin</option>
                                                <option value="Manager" <%=typeof admin !=='undefined' &&
                                                    admin.role=="Manager" ? "selected" : "" %>>Manager</option>
                                                <option value="Staff" <%=typeof admin !=='undefined' &&
                                                    admin.role=="Staff" ? "selected" : "" %>>Staff</option>
                                            </select>
                                        </div>

                                        <div class="col-md-6 mb-4">
                                            <label class="font-weight-500 text-secondary small">Account Status</label>
                                            <select name="status" class="form-control custom-input">
                                                <option value="Active" <%=typeof admin !=='undefined' &&
                                                    admin.status=="Active" ? "selected" : "" %>>Active</option>
                                                <option value="Inactive" <%=typeof admin !=='undefined' &&
                                                    admin.status=="Inactive" ? "selected" : "" %>>Inactive</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center justify-content-start mt-4"
                                        style="gap: 12px;">
                                        <button type="submit" class="btn text-white px-5 shadow-sm"
                                            style="background-color: #6c5dd3; border-radius: 10px; font-weight: 500;">
                                            📥 Save Changes
                                        </button>
                                        <a href="/admin" class="btn btn-light px-4"
                                            style="border-radius: 10px; font-weight: 500;">Back</a>
                                    </div>

                                </form>
                            </div>

                        </div>
                </div>
        </div>
    </div>

    <style>
        .main-content-wrapper {
            margin-left: 260px;
            min-height: 100vh;
            padding: 30px;
            transition: all 0.3s ease-in-out;
        }

        .custom-input {
            background-color: #1e1e2f !important;
            border: 1px solid #5c5780 !important;
            border-radius: 10px !important;
            padding: 10px 14px !important;
            height: auto !important;
            color: white !important;
            transition: all 0.2s ease-in-out !important;
        }

        .custom-input:focus {
            background-color: #1e1e2f !important;
            border-color: #6c5dd3 !important;
            box-shadow: 0 0 0 3px rgba(108, 93, 211, 0.15) !important;
        }

        .font-weight-500 {
            font-weight: 500;
        }

        select.custom-input option {
            background-color: #1e1e2f;
            color: white;
        }

        ::placeholder {
            color: rgba(209, 209, 209, 0.35) !important;
        }
    </style>