<%- include('../header') %>
    <div class="d-flex w-100" style="min-height: 100vh; background-color: #1e1e2f;">

        <div class="d-flex w-100" style="min-height: 100vh;">

            <%- include('../sidebar') %>

                <div class="main-content-wrapper flex-grow-1" id="mainContent">

                    <%- include('../navbar') %>

                        <div class="container-fluid py-4">

                            <div class="d-flex align-items-center justify-content-between border-0 pt-4 px-4 mb-4">
                                <div>
                                    <h4 class="font-weight-bold text-white mb-2">
                                        <span style="color: #6c5dd3; margin-right: 8px;">👑</span> Admin Management
                                    </h4>
                                    <p class="text-white small mb-0">Monitor platform access controls, roles, and
                                        administrative login configurations.</p>
                                </div>
                                <a href="/admin/add" class="btn text-white px-4 shadow-sm d-flex align-items-center"
                                    style="background-color: #6c5dd3; border-radius: 10px; font-weight: 500; gap: 8px;">
                                    <span>➕</span> Add Admin
                                </a>
                            </div>

                            <div class="px-4">
                                <div class="table-responsive style-table-container">
                                    <table class="table text-white mb-0">
                                        <thead>
                                            <tr>
                                                <th scope="col"
                                                    class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                    #</th>
                                                <th scope="col"
                                                    class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                    Name</th>
                                                <th scope="col"
                                                    class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                    Email</th>
                                                <th scope="col"
                                                    class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                    Mobile</th>
                                                <th scope="col"
                                                    class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                    Role</th>
                                                <th scope="col"
                                                    class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                    Status</th>
                                                <th scope="col"
                                                    class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                    Created Date</th>
                                                <th scope="col"
                                                    class="border-0 small text-uppercase text-secondary font-weight-bold text-right">
                                                    Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if(typeof admins !=='undefined' && admins.length> 0){ %>
                                                <% admins.forEach((admin, index)=> { %>
                                                    <tr class="align-middle border-bottom-row">
                                                        <td>
                                                            <%= index + 1 %>
                                                        </td>

                                                        <td class="font-weight-bold text-dark">
                                                            <%= admin.firstName %>
                                                                <%= admin.lastName %>
                                                        </td>

                                                        <td class="text-secondary small">
                                                            <%= admin.email %>
                                                        </td>

                                                        <td class="text-secondary small">
                                                            <%= admin.mobile || "N/A" %>
                                                        </td>

                                                        <td>
                                                            <% if(admin.role==="Super Admin" ){ %>
                                                                <span
                                                                    class="badge px-3 py-2 rounded-pill badge-superadmin">
                                                                    🛡️ Super Admin
                                                                </span>
                                                                <% } else if(admin.role==="Manager" ){ %>
                                                                    <span
                                                                        class="badge px-3 py-2 rounded-pill badge-manager">
                                                                        💼 Manager
                                                                    </span>
                                                                    <% } else { %>
                                                                        <span
                                                                            class="badge px-3 py-2 rounded-pill badge-staff">
                                                                            👤 Staff
                                                                        </span>
                                                                        <% } %>
                                                        </td>

                                                        <td>
                                                            <span
                                                                class="badge px-3 py-2 rounded-pill <%= admin.status === 'Active' ? 'badge-active' : 'badge-inactive' %>">
                                                                <%= admin.status || 'Active' %>
                                                            </span>
                                                        </td>

                                                        <td class="text-secondary small">
                                                            <%= admin.createdAt ? admin.createdAt.toDateString() : '-'
                                                                %>
                                                        </td>

                                                        <td class="text-right">
                                                            <div class="d-flex justify-content-end gap-2"
                                                                style="gap: 8px;">
                                                                <a href="/admin/edit/<%= admin._id %>"
                                                                    class="btn btn-sm text-white border-0 action-btn-edit"
                                                                    style="background-color: #2a2a40;">✏️</a>
                                                                <form
                                                                    action="/admin/delete/<%= admin._id %>?_method=DELETE"
                                                                    method="POST" style="display:inline;">
                                                                    <button type="submit"
                                                                        class="btn btn-sm text-white border-0 action-btn-delete"
                                                                        style="background-color: #2a2a40;"
                                                                        onclick="return confirm('Delete this admin?')">🗑️</button>
                                                                </form>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <tr>
                                                                <td colspan="8"
                                                                    class="text-center py-5 text-secondary small">
                                                                    No Admin Profiles Found. Click "+ Add Admin" to
                                                                    deploy an administrator account.
                                                                </td>
                                                            </tr>
                                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                </div>
        </div>
    </div>

    <style>
        .main-content-wrapper {
            margin-left: 260px;
            min-height: 100vh;
            padding: 30px;
            transition: all 0.3s ease-in-out;
        }

        .style-table-container {
            background-color: #1a1a26;
            border: 1px solid #2d3238;
            border-radius: 12px;
            overflow: hidden;
        }

        .table thead {
            background-color: #222235;
        }

        .table th,
        .table td {
            padding: 16px 20px;
            vertical-align: middle;
        }

        .border-bottom-row {
            border-bottom: 1px solid #252538;
        }

        /* Status Badge Stylings */
        .badge-active {
            background-color: rgba(40, 167, 69, 0.15);
            color: #28a745;
        }

        .badge-inactive {
            background-color: rgba(220, 53, 69, 0.15);
            color: #dc3545;
        }

        /* Role Badge Stylings */
        .badge-superadmin {
            background-color: rgba(220, 53, 69, 0.12);
            color: #ff5c75;
            border: 1px solid rgba(220, 53, 69, 0.25);
        }

        .badge-manager {
            background-color: rgba(255, 193, 7, 0.12);
            color: #ffc107;
            border: 1px solid rgba(255, 193, 7, 0.25);
        }

        .badge-staff {
            background-color: rgba(23, 162, 184, 0.12);
            color: #17a2b8;
            border: 1px solid rgba(23, 162, 184, 0.25);
        }

        /* Action Buttons Hover Transitions */
        .action-btn-edit:hover {
            background-color: #6c5dd3 !important;
            transition: background 0.2s ease;
        }

        .action-btn-delete:hover {
            background-color: #dc3545 !important;
            transition: background 0.2s ease;
        }

        .font-weight-500 {
            font-weight: 500;
        }
    </style>