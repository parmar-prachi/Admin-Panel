<%- include('../header') %>

    <div class="d-flex w-100" style="min-height: 100vh; background-color: #1e1e2f;">

        <%- include('../sidebar') %>

            <div class="main-content-wrapper flex-grow-1" id="mainContent">

                <%- include('../navbar') %>

                    <div class="container-fluid py-4">

                        <div class="d-flex justify-content-between align-items-center border-0 pt-4 px-4 mb-4">
                            <div>
                                <h4 class="font-weight-bold text-white mb-2">
                                    <span style="color: #6c5dd3; margin-right: 8px;">✨</span> Extra Sub Categories
                                </h4>
                                <p class="text-white small mb-0">
                                    Manage deep system classifications and nested catalog layers.
                                </p>
                            </div>
                            <a href="/extrasubcategory/add"
                                class="btn text-white px-4 shadow-sm d-flex align-items-center"
                                style="background-color: #6c5dd3; border-radius: 10px; font-weight: 500; gap: 8px;">
                                <span>➕</span> Add Extra Sub Category
                            </a>
                        </div>

                        <div class="px-4 mb-4">
                            <form action="/extrasubcategory" method="GET" class="d-flex align-items-center gap-2"
                                style="gap: 10px;">
                                <input type="text" name="search" class="form-control custom-input"
                                    placeholder="Search categories..." value="<%= search %>">

                                <select name="status" class="form-control custom-input" style="max-width: 180px;">
                                    <option value="" <%=status==="" ? "selected" : "" %>>All Status</option>
                                    <option value="Active" <%=status==="Active" ? "selected" : "" %>>Active</option>
                                    <option value="Inactive" <%=status==="Inactive" ? "selected" : "" %>>Inactive
                                    </option>
                                </select>

                                <button class="btn text-white px-4"
                                    style="background-color: #6c5dd3; border-radius: 10px; font-weight: 500;">
                                    Filter
                                </button>

                                <a href="/extrasubcategory" class="btn btn-light px-4"
                                    style="border-radius: 10px; font-weight: 500;">
                                    Reset
                                </a>
                            </form>
                        </div>

                        <div class="px-4">
                            <div class="table-responsive style-table-container">
                                <table class="table text-white align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">ID
                                            </th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                Image</th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                Parent Category</th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                Sub Category</th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                Extra Sub Category</th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                Status</th>
                                            <th scope="col"
                                                class="border-0 small text-uppercase text-secondary font-weight-bold text-right">
                                                Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (typeof extraSubCategories !=='undefined' && extraSubCategories.length> 0)
                                            { %>
                                            <% extraSubCategories.forEach((extra, index)=> { %>
                                                <tr class="align-middle border-bottom-row">
                                                    <td class="text-secondary small">
                                                        <%= index + 1 %>
                                                    </td>

                                                    <td>
                                                        <% if(extra.image){ %>
                                                            <img src="/uploads/<%= extra.image %>"
                                                                alt="<%= extra.name %>" class="table-media-preview">
                                                            <% } else { %>
                                                                <div class="table-media-placeholder">📦</div>
                                                                <% } %>
                                                    </td>

                                                    <td>
                                                        <span class="badge px-2 py-1 rounded small text-dark fs-6">
                                                            <%= extra.subCategory?.category?.name || "-" %>
                                                        </span>
                                                    </td>

                                                    <td class="font-weight-bold text-dark opacity-90">
                                                        <%= extra.subCategory?.name || "-" %>
                                                    </td>

                                                    <td class="font-weight-bold" style="color: #6c5dd3;">
                                                        <%= extra.name %>
                                                    </td>

                                                    <td>
                                                        <span
                                                            class="badge px-3 py-2 rounded-pill <%= extra.status === 'Active' ? 'badge-active' : 'badge-inactive' %>">
                                                            <%= extra.status || 'Active' %>
                                                        </span>
                                                    </td>

                                                    <td class="text-right">
                                                        <div class="d-flex justify-content-end align-items-center"
                                                            style="gap: 8px;">
                                                            <a href="/extrasubcategory/edit/<%= extra._id %>"
                                                                class="btn btn-sm text-white border-0 action-btn-utility"
                                                                style="background-color: #2a2a40;" title="Edit Segment">
                                                                ✏️
                                                            </a>

                                                            <a href="/extrasubcategory/delete/<%= extra._id %>"
                                                                class="btn btn-sm text-white border-0 action-btn-delete"
                                                                style="background-color: #2a2a40;"
                                                                title="Delete Element"
                                                                onclick="return confirm('Are you sure you want to permanently delete this sub-category path?')">
                                                                🗑️
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="8"
                                                                class="text-center py-5 text-secondary small">
                                                                No extra sub-categories recorded in the database.
                                                            </td>
                                                        </tr>
                                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <% if(totalPages> 1){ %>
                            <nav class="mt-4 px-4">
                                <ul class="pagination justify-content-center mb-0">
                                    <% if(page> 1){ %>
                                        <li class="page-item">
                                            <a class="page-link"
                                                href="/extrasubcategory?page=<%= page-1 %>&search=<%= search %>&status=<%= status %>">
                                                Previous
                                            </a>
                                        </li>
                                        <% } %>

                                            <% for(let i=1; i <=totalPages; i++){ %>
                                                <li class="page-item <%= page === i ? 'active' : '' %>">
                                                    <a class="page-link"
                                                        href="/extrasubcategory?page=<%= i %>&search=<%= search %>&status=<%= status %>">
                                                        <%= i %>
                                                    </a>
                                                </li>
                                                <% } %>

                                                    <% if(page < totalPages){ %>
                                                        <li class="page-item">
                                                            <a class="page-link"
                                                                href="/extrasubcategory?page=<%= page+1 %>&search=<%= search %>&status=<%= status %>">
                                                                Next
                                                            </a>
                                                        </li>
                                                        <% } %>
                                </ul>
                            </nav>
                            <% } %>

                    </div>
            </div>
    </div>

    <style>
        .main-content-wrapper {
            margin-left: 260px;
            min-height: 100vh;
            padding: 30px;
            transition: all 0.3s ease-in-out;
        }

        /* Forms & Inputs styling */
        .custom-input {
            background-color: #1e1e2f !important;
            border: 1px solid #5c5780 !important;
            border-radius: 10px !important;
            padding: 10px 14px !important;
            height: 45px !important;
            color: white !important;
            transition: all 0.2s ease-in-out !important;
        }

        .custom-input:focus {
            background-color: #1e1e2f !important;
            border-color: #6c5dd3 !important;
            box-shadow: 0 0 0 3px rgba(108, 93, 211, 0.15) !important;
        }

        .custom-input::placeholder {
            color: rgba(209, 209, 209, 0.35) !important;
        }

        select.custom-input option {
            background-color: #1e1e2f;
            color: white;
        }

        /* Container & Table Layout styling */
        .style-table-container {
            background-color: #1a1a26;
            border: 1px solid #2d3238;
            border-radius: 12px;
            overflow: hidden;
        }

        .table thead {
            background-color: #222235;
        }

        .table th,
        .table td {
            padding: 16px 20px;
            vertical-align: middle;
            border: none;
        }

        .border-bottom-row {
            border-bottom: 1px solid #252538;
        }

        .table tbody tr:hover {
            background-color: #252538;
            transition: background-color 0.2s ease;
        }

        /* Image Display Utilities */
        .table-media-preview {
            width: 46px;
            height: 46px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #3a3a52;
            transition: transform 0.2s ease-in-out;
        }

        .table-media-preview:hover {
            transform: scale(1.1);
        }

        .table-media-placeholder {
            width: 46px;
            height: 46px;
            background-color: #252538;
            border: 1px dashed #5c5780;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            opacity: 0.65;
        }

        .truncate-text {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Custom Badges (Status indicators) */
        .badge-active {
            background-color: rgba(40, 167, 69, 0.12) !important;
            color: #28a745 !important;
            font-weight: 500;
        }

        .badge-inactive {
            background-color: rgba(220, 53, 69, 0.12) !important;
            color: #ff5c75 !important;
            font-weight: 500;
        }

        /* Table row utility actions hover */
        .action-btn-utility:hover {
            background-color: #6c5dd3 !important;
            transform: translateY(-1px);
        }

        .action-btn-status:hover {
            background-color: #ffc107 !important;
            color: #12121c !important;
            transform: translateY(-1px);
        }

        .action-btn-delete:hover {
            background-color: #dc3545 !important;
            transform: translateY(-1px);
        }

        /* Styled Pagination System */
        .pagination .page-link {
            background-color: #222235;
            color: #a7a7b8;
            border: 1px solid #2d3238;
            margin: 0 4px;
            border-radius: 8px;
            padding: 8px 16px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .pagination .page-link:hover {
            background-color: #6c5dd3;
            border-color: #6c5dd3;
            color: white;
        }

        .pagination .page-item.active .page-link {
            background-color: #6c5dd3;
            border-color: #6c5dd3;
            color: white;
            box-shadow: 0 4px 10px rgba(108, 93, 211, 0.25);
        }

        /* Responsive Breakpoints */
        @media(max-width: 992px) {
            .main-content-wrapper {
                margin-left: 0;
                padding: 20px;
            }

            .table-responsive {
                border-radius: 8px;
            }
        }
    </style>