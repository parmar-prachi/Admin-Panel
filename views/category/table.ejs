<%- include('../header') %>
    <div class="d-flex w-100" style="min-height: 100vh; background-color: #1e1e2f;">

        <div class="d-flex w-100" style="min-height: 100vh;">

            <%- include('../sidebar') %>

                <div class="main-content-wrapper flex-grow-1" id="mainContent">

                    <%- include('../navbar') %>

                        <div class="container-fluid py-4">

                            <div class="d-flex align-items-center justify-content-between border-0 pt-4 px-4 mb-4">
                                <div>
                                    <h4 class="font-weight-bold text-white mb-2">
                                        <span style="color: #6c5dd3; margin-right: 8px;">📁</span> Categories
                                    </h4>
                                    <p class="text-white small mb-0">Manage and organize system classifications and item
                                        buckets.</p>
                                </div>
                                <a href="/category/add" class="btn text-white px-4 shadow-sm d-flex align-items-center"
                                    style="background-color: #6c5dd3; border-radius: 10px; font-weight: 500; gap: 8px;">
                                    <span>➕</span> Add Category
                                </a>
                            </div>

                            <div class="px-4">
                                <div class="table-responsive">
                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                    
                                        <form action="/category" method="GET" class="d-flex align-items-center" style="gap:10px;">
                                    
                                            <input type="text" name="search" class="form-control" placeholder="Search Category..." value="<%= search %>">
                                    
                                            <select name="status" class="form-control">
                                    
                                                <option value="" <%=status==="" ? "selected" : "" %>>
                                                    All Status
                                                </option>
                                    
                                                <option value="Active" <%=status==="Active" ? "selected" : "" %>>
                                                    Active
                                                </option>
                                    
                                                <option value="Inactive" <%=status==="Inactive" ? "selected" : "" %>>
                                                    Inactive
                                                </option>
                                    
                                            </select>
                                    
                                            <button class="btn text-white" style="background:#6c5dd3;">
                                    
                                                Search
                                    
                                            </button>
                                    
                                            <a href="/category" class="btn btn-secondary">
                                    
                                                Reset
                                    
                                            </a>
                                    
                                        </form>
                                    
                                    
                                    </div>
                                    <table class="table text-white mb-0">
                                        <thead>
                                            <tr>
                                                <th scope="col"
                                                    class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                    ID</th>
                                                <th scope="col"
                                                    class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                    Image</th>
                                                <th scope="col"
                                                    class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                    Category Name</th>
                                                <th scope="col"
                                                    class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                    Slug/URL String</th>
                                                <th scope="col"
                                                    class="border-0 small text-uppercase text-secondary font-weight-bold">
                                                    Status</th>
                                                <th scope="col"
                                                    class="border-0 small text-uppercase text-secondary font-weight-bold text-right">
                                                    Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (typeof categories !=='undefined' && categories.length> 0) { %>
                                                <% categories.forEach((cat, index)=> { %>
                                                    <tr class="align-middle border-bottom-row">
                                                        <td>
                                                            <%= index + 1 %>
                                                        </td>
                                                        <td>
                                                            <% if (cat.image) { %>
                                                                <img src="/uploads/<%= cat.image %>"
                                                                    alt="<%= cat.name %>" class="category-thumbnail">
                                                                <% } else { %>
                                                                    <div class="category-thumbnail-placeholder">
                                                                        <span>📁</span>
                                                                    </div>
                                                                    <% } %>
                                                        </td>
                                                        <td class="font-weight-bold text-dark fs-5">
                                                            <%= cat.name %>
                                                        </td>
                                                        <td class="text-secondary fs-5">
                                                            <%= cat.slug || ('/' +
                                                                cat.name.toLowerCase().replace(/\s+/g, '-' )) %>
                                                        </td>
                                                        <td>

                                                            <% if(cat.status==="Active" ){ %>

                                                                <span class="badge-active px-3 py-2 rounded-pill ">

                                                                    Active

                                                                </span>

                                                                <% } else { %>

                                                                    <span class="badge-inactive px-3 py-2 rounded-pill">

                                                                        Inactive

                                                                    </span>

                                                                    <% } %>

                                                                        </a>
                                                        </td>
                                                        <td class="text-right">
                                                            <div class="d-flex gap-2" style="gap: 8px;">
                                                                <a href="/category/edit/<%= cat._id %>"
                                                                    class="btn text-white border-0 action-btn-hover"
                                                                    style="background-color: #2a2a40;"><i
                                                                        class="bi bi-pencil fs-5"></i></a>

                                                                <a href="/category/delete/<%= cat._id %>"
                                                                    class="btn text-white border-0 action-btn-hover"
                                                                    style="background-color:#2a2a40;"
                                                                    onclick="return confirm('Are you sure you want to delete this category?')">
                                                                    <i class="bi bi-trash fs-5"></i>
                                                                </a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <tr>
                                                                <td colspan="6"
                                                                    class="text-center py-5 text-secondary small">
                                                                    No categories found. Click "+ Add Category" to
                                                                    insert your first record.
                                                                </td>
                                                            </tr>
                                                            <% } %>
                                        </tbody>
                                    </table>
                                    <% if(totalPages> 1){ %>

                                        <nav class="mt-4">

                                            <ul class="pagination justify-content-center">

                                                <% if(page> 1){ %>

                                                    <li class="page-item">
                                                        <a class="page-link"
                                                            href="/category?page=<%= page-1 %>&search=<%= search %>"
                                                            style=" background-color: #6c5dd3 ; border: none ; color:white; font-size:16px;">
                                                            Previous
                                                        </a>
                                                    </li>

                                                    <% } %>

                                                        <% for(let i=1; i<=totalPages; i++){ %>

                                                            <li class="page-item <%= page===i ? 'active' : '' %>">

                                                                <a class="page-link"
                                                                    href="/category?page=<%= i %>&search=<%= search %>">

                                                                    <%= i %>

                                                                </a>

                                                            </li>

                                                            <% } %>

                                                                <% if(page < totalPages){ %>

                                                                    <li class="page-item">

                                                                        <a class="page-link"
                                                                            href="/category?page=<%= page+1 %>&search=<%= search %>"
                                                                            style=" background-color: #6c5dd3 ; border: none ; color:white; font-size:16px;">

                                                                            Next

                                                                        </a>

                                                                    </li>

                                                                    <% } %>

                                            </ul>

                                        </nav>

                                        <% } %>
                                </div>
                            </div>

                        </div>
                </div>
        </div>
    </div>

    <style>
        .main-content-wrapper {
            margin-left: 260px;
            min-height: 100vh;
            padding: 30px;
            transition: all 0.3s ease-in-out;
        }

        .style-table-container {
            background-color: #1a1a26;
            border: 1px solid #2d3238;
            border-radius: 12px;
            overflow: hidden;
        }

        .table thead {
            background-color: #222235;
        }

        .table th,
        .table td {
            padding: 16px 20px;
            vertical-align: middle;
        }

        .border-bottom-row {
            border-bottom: 1px solid #252538;
        }

        /* Image & Placeholder Styles */
        .category-thumbnail {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #5c5780;
        }

        .category-thumbnail-placeholder {
            width: 50px;
            height: 50px;
            background-color: #252538;
            border: 1px dashed #5c5780;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .badge-active {
            background-color: rgba(40, 167, 69, 0.15);
            color: #28a745;
        }

        .badge-inactive {
            background-color: rgba(220, 53, 69, 0.15);
            color: #dc3545;
        }

        .action-btn-hover:hover {
            background-color: #6c5dd3 !important;
            transition: background 0.2s ease;
        }

        .font-weight-500 {
            font-weight: 500;
        }
    </style>