<%- include('../header') %>

    <div class="d-flex w-100" style="min-height: 100vh; background-color: #1e1e2f;">

        <%- include('../sidebar') %>

            <div class="main-content-wrapper flex-grow-1" id="mainContent">

                <%- include('../navbar') %>

                    <div class="container-fluid py-4">

                        <div class="card-header border-0 pt-4 px-4">
                            <h4 class="font-weight-bold text-white mb-2">
                                <span style="color:#6c5dd3;">✏️</span> Edit Category
                            </h4>

                            <p class="text-white small mb-0">
                                Update category information.
                            </p>
                        </div>

                        <div class="card-body p-4">

                            <form action="/category/update/<%= category._id %>" method="POST"
                                enctype="multipart/form-data">

                                <!-- Category Name -->
                                <div class="mb-3">
                                    <label class="font-weight-500 text-secondary small">
                                        Category Name
                                    </label>

                                    <input type="text" name="name" class="form-control custom-input"
                                        value="<%= category.name %>" required>
                                </div>

                                <!-- Description -->
                                <div class="mb-3">

                                    <label class="font-weight-500 text-secondary small">
                                        Description
                                    </label>

                                    <textarea name="description" rows="4"
                                        class="form-control custom-input"><%= category.description || "" %></textarea>

                                </div>

                                <!-- Status -->
                                <div class="mb-3">

                                    <label class="font-weight-500 text-secondary small">
                                        Status
                                    </label>

                                    <select name="status" class="form-control custom-input">

                                        <option value="Active" <%=category.status==="Active" ? "selected" : "" %>>
                                            Active
                                        </option>

                                        <option value="Inactive" <%=category.status==="Inactive" ? "selected" : "" %>>
                                            Inactive
                                        </option>

                                    </select>

                                </div>

                                <!-- Current Image -->
                                <div class="mb-3">

                                    <label class="font-weight-500 text-secondary small">
                                        Current Image
                                    </label>

                                    <br>

                                    <% if(category.image){ %>

                                        <img src="/uploads/<%= category.image %>" width="140"
                                            class="rounded shadow mb-3">

                                        <% } else { %>

                                            <p class="text-secondary">
                                                No image uploaded
                                            </p>

                                            <% } %>

                                </div>

                                <!-- New Image -->
                                <div class="mb-4">

                                    <label class="font-weight-500 text-secondary small">
                                        Change Image
                                    </label>

                                    <input type="file" name="image" class="form-control custom-input">

                                </div>

                                <!-- Buttons -->
                                <div class="d-flex justify-content-end">

                                    <a href="/category" class="btn btn-light mr-2">

                                        Cancel

                                    </a>

                                    <button type="submit" class="btn text-white ms-2" style="background:#6c5dd3;">

                                        💾 Update Category

                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>

            </div>

    </div>

    <style>
        .main-content-wrapper {
            margin-left: 260px;
            min-height: 100vh;
            padding: 30px;
        }

        .custom-input {
            background: #1e1e2f !important;
            border: 1px solid #5c5780 !important;
            color: white !important;
            border-radius: 10px;
        }

        .custom-input:focus {
            background: #1e1e2f !important;
            border-color: #6c5dd3 !important;
            box-shadow: 0 0 0 3px rgba(108, 93, 211, .2);
        }

        .custom-input option {
            background: #1e1e2f;
            color: white;
        }
    </style>